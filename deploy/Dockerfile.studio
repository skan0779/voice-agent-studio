FROM node:22-bookworm-slim AS build

WORKDIR /build

COPY package.json package-lock.json ./
COPY apps/studio/package.json ./apps/studio/package.json

RUN npm ci

COPY apps/studio/ ./apps/studio/

ARG VITE_RUNTIME_API_URL
ARG VITE_RESEARCH_API_URL

ENV VITE_RUNTIME_API_URL=${VITE_RUNTIME_API_URL} \
    VITE_RESEARCH_API_URL=${VITE_RESEARCH_API_URL}

# Vite embeds these endpoints into the browser bundle at build time.
RUN test -n "${VITE_RUNTIME_API_URL}" \
    && test -n "${VITE_RESEARCH_API_URL}" \
    && npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/apps/studio/dist/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
