# Inject these server-side values through the deployment platform or Secret Manager.
DATABASE_URL=postgresql+psycopg://user:password@database.example.com:5432/voice_agent_studio?sslmode=require
RUNTIME_SECRET_KEY=replace-with-a-long-random-secret
STUDIO_ORIGINS=https://studio.example.com
ALLOW_UNSAFE_CODE_ACTIONS=false

# Public Studio build arguments. Values prefixed with VITE_ are embedded in the browser bundle.
VITE_RUNTIME_API_URL=https://runtime.example.com
