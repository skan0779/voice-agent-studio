# Local PostgreSQL container
POSTGRES_DB=voice_agent_studio
POSTGRES_USER=voice_agent_studio
POSTGRES_PASSWORD=local-voice-agent-studio-password
POSTGRES_PORT=5432

# Runtime service
DATABASE_URL=postgresql+psycopg://voice_agent_studio:local-voice-agent-studio-password@localhost:5432/voice_agent_studio
RUNTIME_SECRET_KEY=replace-with-a-long-random-secret
STUDIO_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
ALLOW_UNSAFE_CODE_ACTIONS=false
